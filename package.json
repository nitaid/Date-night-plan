{
  "name": "date-night",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A date-night planner for two: shared wishlist, AI itinerary generation, and one-tap Apple/Google calendar scheduling.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
