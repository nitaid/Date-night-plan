# ---- AI plan generation (server-side only; never exposed to the browser) ----
# Get a key at https://console.anthropic.com/settings/keys
# Without it the app still works fully using the built-in offline planner.
ANTHROPIC_API_KEY=

# Optional: override the model used for plan generation.
# DATE_NIGHT_MODEL=claude-opus-5

# ---- Shared cloud sync between the two of you (optional) ----
# Create a free project at https://supabase.com, run supabase/schema.sql in the
# SQL editor, then paste the Project URL + anon key here.
# Without these the app runs local-first on each device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
